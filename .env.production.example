# ─────────────────────────────────────────────────────────
# .env PRODUCTION TEMPLATE — copy ke .env di server, lalu isi
# Jangan commit .env asli ke git!
# ─────────────────────────────────────────────────────────

APP_NAME="SIMRS Hospital"
APP_ENV=production
APP_KEY=                          # ← jalankan: php artisan key:generate
APP_DEBUG=false                   # WAJIB false di production (kalau true, error trace bocor)
APP_URL=https://domain-anda.id    # ← ganti ke domain HTTPS

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ─── Logging ───
LOG_CHANNEL=daily                 # rotasi log per hari
LOG_LEVEL=warning                 # production: hanya warning ke atas (skip debug/info)

# ─── Database (PRODUCTION) ───
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hospital_prod         # ← ganti
DB_USERNAME=hospital_user         # ← ganti, JANGAN pakai root
DB_PASSWORD=                      # ← password kuat min 16 char

# ─── Session (production: redis lebih cepat) ───
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true              # production: encrypt session cookie
SESSION_SECURE_COOKIE=true        # WAJIB true di HTTPS — cookie hanya kirim via TLS
SESSION_SAME_SITE=lax

# ─── Cache (production: file/database/redis) ───
CACHE_STORE=database
QUEUE_CONNECTION=database

# ─── Mail (production: gunakan SMTP real) ───
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=                    # ← email pengirim
MAIL_PASSWORD=                    # ← app password (bukan password akun)
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@domain-anda.id
MAIL_FROM_NAME="${APP_NAME}"

# ─── License Pairing v3 (PRODUCTION) ───
LICENSE_SERVER_URL=https://whitelabel.co.id
LICENSE_DEV_BYPASS=false          # WAJIB false di production — aktifkan license check
LICENSE_HEARTBEAT_INTERVAL=86400  # 24 jam
LICENSE_HEARTBEAT_GRACE=604800    # 7 hari grace kalau marketplace down

# ─── HTTPS Trust (kalau di belakang reverse proxy seperti Cloudflare/nginx) ───
TRUSTED_PROXIES=*                 # set IP proxy spesifik untuk lebih aman
FORCE_HTTPS=true                  # paksa redirect http → https

# ─── Vite (asset build) ───
VITE_APP_NAME="${APP_NAME}"
